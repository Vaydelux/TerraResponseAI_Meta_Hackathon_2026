# TerraResponse AI — environment variables
#
# Copy this file to `.env` and fill in the values.
# Never commit the real `.env` (it is gitignored). Never put API keys
# in client components — every variable below is read server-side
# only (Server-only). See `docs/SECURITY.md` §7.

# --- Supabase (email auth + SSR + database + storage) ---
# Required. Get these from the Supabase dashboard → Project Settings → API.
# When all three are empty, /login shows a setup state.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Node environment ---
NODE_ENV="development"

# --- Meta Model API (server-side only) ---
# The Meta Model API key — NEVER expose to the browser.
# Empty = the analyze endpoint returns 503 NOT_CONFIGURED.
MODEL_API_KEY=""
META_MODEL_BASE_URL="https://api.meta.ai/v1"
META_VISION_MODEL="muse-spark-1.3"

# --- SAM 3.1 Media Segmentation (optional, server-side only) ---
# Empty = segmentation is skipped by default.
SAM_API_KEY=""
SAM_MODEL_BASE_URL="https://api.meta.ai/v1"
SAM_MODEL="sam-3.1"

# --- Upload & storage (optional, with safe defaults) ---
UPLOAD_MAX_BYTES="10485760"
UPLOAD_RATE_LIMIT_PER_HOUR="20"

# --- Login rate limit (optional, with safe default) ---
# Per-account login attempts per hour (default 10). Enforced server-side
# via the audit_events table to mitigate brute-force attacks.
LOGIN_RATE_LIMIT_PER_HOUR="10"

# --- Resilience & cost controls (optional, with safe defaults) ---
AI_DAILY_SPEND_CEILING_USD="50"
AI_DAILY_REQUEST_CEILING="1000"
AI_PER_EVENT_BUDGET="500"
AI_PER_USER_CALLS_PER_HOUR="30"
SIGNED_URL_RATE_LIMIT_PER_MIN="60"
AI_CALL_TIMEOUT_MS="30000"
AI_MAX_RETRIES="4"
AI_COST_PER_1M_INPUT_TOKENS_USD="0.30"
AI_COST_PER_1M_OUTPUT_TOKENS_USD="0.60"
AI_COST_PER_CALL_FLAT_USD="0.001"

# --- Retention workflow (optional, with safe defaults) ---
RETENTION_WINDOW_DAYS="7"
RETENTION_ADMIN_OVERRIDE=""

# --- Demo Mode (optional) ---
# Set to "1" to show the "Demonstration Data" banner on every page.
DEMO_MODE=""

# --- Demo seed credentials (REQUIRED for demo seeding — no defaults) ---
# These passwords are NOT shipped with a default. The seed scripts
# (scripts/seed-demo.ts, scripts/seed.ts) refuse to run unless each is
# set to a strong value (>= 12 chars). Generate with:
#   openssl rand -base64 24
#
# For production first-admin setup, do NOT use the demo seed. Use:
#   1. Sign up at /login (the handle_new_user trigger creates a
#      profile with role='reporter').
#   2. Run: bun run scripts/bootstrap-admin.ts <your-email>
#      (refuses if any admin already exists — one-time gate).
#
# The seed scripts also refuse to seed against a non-local Supabase
# URL unless ALLOW_DEMO_SEED_ON_PRODUCTION=1 is set.
DEMO_SEED_ADMIN_EMAIL="admin@terra.ai"
DEMO_SEED_ADMIN_PASSWORD=""
DEMO_SEED_REVIEWER_EMAIL="reviewer@terra.ai"
DEMO_SEED_REVIEWER_PASSWORD=""
DEMO_SEED_REPORTER_PASSWORD=""
ALLOW_DEMO_SEED_ON_PRODUCTION=""
